# KBO Open Data portal login (https://kbopub.economie.fgov.be/kbo-open-data)
KBO_USERNAME=your_kbo_username
KBO_PASSWORD=your_kbo_password

# Optional PostgreSQL overrides (defaults shown)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kbo
POSTGRES_USER=root
POSTGRES_PASSWORD=root

# Optional read-only login for Power BI, created by kbo-warehouse (no login without a password)
POWERBI_USER=powerbi_reader
POWERBI_PASSWORD=choose_a_password
