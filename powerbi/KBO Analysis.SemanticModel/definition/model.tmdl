model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

ref table 'Enterprise Facts'
ref table 'Establishment Facts'
ref table Enterprise
ref table Date
ref table Geography
ref table Activity
ref table 'Juridical Form'
ref table 'Juridical Situation'
ref table Refresh
