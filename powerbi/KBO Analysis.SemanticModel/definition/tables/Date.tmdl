table Date

	column 'Date Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Date Key

	column Date
		dataType: dateTime
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: Date

	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Year

	column Quarter
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Quarter

	column Month
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: Month

	column 'Month Name'
		dataType: string
		summarizeBy: none
		sourceColumn: Month Name
		sortByColumn: Month

	column Day
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Day

	column 'Weekday Number'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: Weekday Number

	column Weekday
		dataType: string
		summarizeBy: none
		sourceColumn: Weekday
		sortByColumn: 'Weekday Number'

	column Decade
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Decade

	hierarchy 'Start Date'

		level Decade
			column: Decade

		level Year
			column: Year

		level Quarter
			column: Quarter

		level 'Month Name'
			column: 'Month Name'

	partition Date = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(Server, Database),
				    Data = Source{[Schema = "powerbi", Item = "Date"]}[Data]
				in
				    Data
